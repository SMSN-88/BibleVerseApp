@page "/"
@inject BibleService BibleService
@using BibleVerseGenApp;

<PageTitle>Bible Verse Generator</PageTitle>
<div class="phone-frame">
    <h3>📖 Random Bible Verse</h3>
    @if (verse != null)
    {
        <blockquote>
            <p>@verse.Text</p>
            <footer>@BibleService.FormatReference(verse)</footer>
        </blockquote>
    }
    <button class="btn btn-primary" @onclick="@LoadVerse">Load Random Verse</button>
</div>

@code{
    private BibleVerse? verse;
    protected override async Task OnInitializedAsync()
    {
        await LoadVerse();
    }
    private async Task LoadVerse()
    {
        verse = await BibleService.GetRandomVerseAsync();
    }
}
<style>
    /* Phone container */
    .phone-frame {
        width: 360px;
        height: 640px;
        background: #fff;
        border-radius: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        margin: auto;
        padding: 2rem 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: center;
    }

        /* Verse */
        .phone-frame blockquote {
            background: #f1f5ff;
            border-left: 5px solid #4a90e2;
            border-radius: 12px;
            padding: 1rem;
            font-style: italic;
            font-size: 1.1rem;
            line-height: 1.6;
        }

        /* Button inside phone */
        .phone-frame .btn-primary {
            border-radius: 25px;
            font-size: 1.1rem;
            padding: 0.7rem;
        }


</style>